# Copia este archivo como .env (no lo subas al repositorio) y completa los valores.
# Clave HMAC en Base64 de al menos 32 bytes aleatorios. Generala con:
#   openssl rand -base64 32
PULSEPASS_JWT_SECRET_BASE64=

# Opcionales (estos son los valores por defecto)
PULSEPASS_JWT_ISSUER=pulsepass-api
PULSEPASS_JWT_ACCESS_TOKEN_TTL=PT15M
